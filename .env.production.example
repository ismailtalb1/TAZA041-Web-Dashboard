APP_NAME="TAZA 041"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.taza041.me
TRUSTED_PROXIES=*

DELIVERY_ROUTING_ENABLED=true
DELIVERY_ROUTING_BASE_URL=https://routing.example.com
DELIVERY_ROUTING_PROFILE=driving
DELIVERY_ROUTING_TIMEOUT=8
DELIVERY_ROUTING_CONNECT_TIMEOUT=4
DELIVERY_ROUTING_CACHE_MINUTES=10
DELIVERY_FALLBACK_SPEED_KPH=30

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Damascus
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taza041
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=app.taza041.me

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=app.taza041.me
CORS_ALLOWED_ORIGINS=https://app.taza041.me
EMPLOYEE_TOKEN_EXPIRATION=480
CUSTOMER_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=taza041_

# Required by `php artisan migrate --seed` in production. Use a unique
# one-time value (12+ characters), then change it from the dashboard.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
