APP_NAME="TAZA 041"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DELIVERY_ROUTING_ENABLED=true
DELIVERY_ROUTING_BASE_URL=https://router.project-osrm.org
DELIVERY_ROUTING_PROFILE=driving
DELIVERY_ROUTING_TIMEOUT=8
DELIVERY_ROUTING_CONNECT_TIMEOUT=4
DELIVERY_ROUTING_CACHE_MINUTES=10
DELIVERY_FALLBACK_SPEED_KPH=30

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Damascus
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
EMPLOYEE_TOKEN_EXPIRATION=480
CUSTOMER_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=taza041_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
